{
  "name": "graficai",
  "private": true,
  "version": "0.1.0",
  "description": "GraficAI — diagnóstico editorial: laudas, castoff, cadernos e custo de impressão",
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/app"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @graficai/app",
    "build": "npm run build --workspace @graficai/app",
    "start": "npm run start --workspace @graficai/app",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/server && tsc -p packages/app --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.68.2"
  }
}
