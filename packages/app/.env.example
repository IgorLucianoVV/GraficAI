# Copie para packages/app/.env.local

# Postgres (Neon, Vercel Postgres, Supabase…). Sem isto, usa PGlite em packages/app/.data (só para rodar local).
# DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require

# Opcional: refinamento da estrutura do manuscrito com Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Limpeza diária de visitantes (cron da Vercel envia "Authorization: Bearer <CRON_SECRET>")
# CRON_SECRET=
# GUEST_RETENTION_DAYS=30
